





with open("moma_artists.csv", "r", encoding="utf-8") as file: # "as" creates a shorthand for file
    reader = csv.DictReader(file) #read the file as dictionary object
    data = list(reader) #converts reader from an object into a list of dictionary items


artists_with_year = [] #new list to hold artists w year data

for artist in data: 
    if artist['BeginDate'] != 0:
        artists_with_year.append(artist)


year_counts = {}
for artist in artists_with_year:
    year = artist['BeginDate'] #store the begin date for each artist
    if year in year_counts: #check to see if the year is already in the dictionary
        year_counts[year] = year_counts[year] + 1 #no quotes around year! we are using the var/string it represents as a key



