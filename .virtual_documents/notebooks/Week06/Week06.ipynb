import requests #brings in functions for getting data from the web and dealing with the responses

#the following variables make up the components of the url we'll use to query the met api
base_url = "https://collectionapi.metmuseum.org" #always the same for each met endpoint
search_path = "/public/collection/v1.1/search" #the specific endpoint for searching for object ids
search_query = "?q=Antelope" #the params for our search. In this case, q means search term and antelope is the keyword.
date_range = "&dateBegin=1900&dateEnd=2000"

#doing a search using an fstring to combine all of the query components
url = f'{base_url}{search_path}{search_query}{date_range}'
search_response = requests.get(url)

print(type(search_response))
print(dir(search_response)) #tells us all the methods and data inside search_response


print(search_response.ok) #did it work?





print(search_response.json()['objectIDs'][0])


#look up specific met objects
first_found_item = search_response.json()['objectIDs'][0]
object_path = "/public/collection/v1/objects/"
url = f"{base_url}{object_path}{first_found_item}"

response_object = requests.get(url)
print(response_object.json())





met_objects = search_response.json() #creates a new list of dictionaries by interpreting the response as json
print(type(met_objects))


print(met_objects.keys()) #shows us the two keys


print(met_objects['total']) #especially important if you're manually paginating responses, for ex. if you only get 100 back at first, but you want the next 100.


antelope_object_ids = (met_objects['objectIDs']) #the list of met object ids representing antelope related artworks
print(len(antelope_object_ids))


#look up specific met objects
antelope_item = antelope_object_ids[0]
object_path = "/public/collection/v1/objects/"
url = f"{base_url}{object_path}{antelope_item}"

response_object = requests.get(url)

antelope_object_details = response_object.json()

antelope_object_details.keys()


antelope_object_details['measurements'] # the child of this is a list of more keys
antelope_object_details['measurements'][0]['elementMeasurements']['Depth'] #adding the zero because it's a list with one item in it





from time import sleep # we are only importing "sleep" from the time library
# #look up specific met objects

# antelope_item = antelope_object_ids[0]

# object_path = "/public/collection/v1/objects/"

# url = f"{base_url}{object_path}{antelope_item}"

# response_object = requests.get(url)

object_path = "/public/collection/v1/objects/"
all_antelope_details = []
for antelope_id in antelope_object_ids:
    url = f"{base_url}{object_path}{antelope_id}"
    response_object = requests.get(url) #making the request to the server
    all_antelope_details.append(response_object.json())
    print(f"Grabbed details from object id {antelope_id}, with status code {response_object.status_code}")
    sleep(0.5) #waiting half a second before moving on to the next step in the loop





